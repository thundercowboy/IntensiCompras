@page "/sair"
@inherits LogoutPage
@layout HeadlessLayout

<PageTitle>IntensiCompras - Sair</PageTitle>

@if (ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@ErrorMessage</MudAlert>
    <MudButton OnClick="@(() => NavigationManager.NavigateTo("/sair", forceLoad: true))">TENTAR NOVAMENTE</MudButton>
}
else
{
    <MudText Typo="Typo.h3">Finalizando sessão...</MudText>
}